DATABASE_URL=
SESSION_SECRET=
SERPAPI_API_KEY=
NODE_ENV=production
APP_ORIGIN=
DATABASE_SSL=true
DB_POOL_MAX=5

# Production object storage for Vercel or another web host.
# Use a bucket path such as /my-bucket/store and keep these values private.
STORAGE_PROVIDER=gcs
PRIVATE_OBJECT_DIR=/my-bucket/store
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=