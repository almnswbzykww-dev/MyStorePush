{
  "version": 2,
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "artifacts/store/dist/public",
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "artifacts/api-server/**",
        "lib/**"
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}